<?xml version="1.0" encoding="utf-8"?>
<!--
  课程色块圆角背景 · 0 号色「淡青」

  ⚠️ 色值必须与 utils/color.js 的 COLOR_POOL[0].fill 完全一致，
     否则 App 里一个颜色、桌面上另一个颜色。
     COLOR_POOL = [
       { name: '淡青', fill: '#E8F4F4' },   ← 本文件
       { name: '淡蓝', fill: '#EAF0F8' },
       { name: '淡绿', fill: '#E4F2E8' },
       { name: '淡黄', fill: '#F6EFE2' },
       { name: '淡粉', fill: '#F4EAF2' },
       { name: '淡紫', fill: '#F2ECF4' }
     ]

  为什么是 6 个独立文件而不是 1 个带 tint 的文件：
    RemoteViews 不能动态改 drawable 颜色，只能 setBackgroundResource(预置资源 id)。
    所以预置 6 个，原生按 colorSeed 选一个（见 QkbWidgetService.kt）。

  corners = 8dp（吴雨 2026-09-17 指定）。再大在桌面小尺寸下会显得圆滚滚。
  ⚠️ XML 注释里不能出现连续两个减号（那是注释结束符的前缀）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle">
  <solid android:color="#E8F4F4" />
  <corners android:radius="8dp" />
</shape>
